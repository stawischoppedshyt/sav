local function teleportTo(cframeTarget)
    local character = LP.Character or LP.CharacterAdded:Wait()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        return false
    end

    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    task.wait(0.02)

    root.CFrame = cframeTarget

    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end)

    return true
end

local function instantGrab(targetPart)
    if not targetPart then return end

    local plot = targetPart:FindFirstAncestorWhichIsA("Model")
    while plot and plot.Parent ~= workspace.Plots do
        plot = plot.Parent
    end

    local pods = plot and plot:FindFirstChild("AnimalPodiums")
    local closestPod = nil
    local closestDist = 12
    if pods then
        for _, pod in ipairs(pods:GetChildren()) do
            local spawn = pod:FindFirstChild("Base") and pod.Base:FindFirstChild("Spawn")
            if spawn then
                local d = (spawn.Position - targetPart.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    closestPod = pod
                end
            end
        end
    end

    local podNum = closestPod and tonumber(closestPod.Name)
    local prompt = (closestPod and closestPod:FindFirstChildWhichIsA("ProximityPrompt", true))
        or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)

    -- Settle delay: give Roblox network physics time to replicate character position to the server
    task.wait(0.35)

    -- Rapid pickup attempts (retries until carrying attribute is set)
    for attempt = 1, 3 do
        if LP:GetAttribute("CarryingStolenBrainrot") == true then
            break
        end

        local sTime = (workspace.GetServerTimeNow and workspace:GetServerTimeNow()) or tick()

        -- 1. Hold began remote handshake
        if HOLD_REMOTE then
            pcall(function()
                HOLD_REMOTE:FireServer(sTime + 53, "5c0bd012-dfb2-4bac-8f1a-e41f136e4744")
                HOLD_REMOTE:FireServer(sTime + 53, "6be28b5b-dbc3-4aab-aa0c-6ebcfa191f22")
            end)
        end

        -- 2. Trigger proximity prompt (0s duration)
        if prompt and fireproximityprompt then
            pcall(function()
                prompt.Enabled = true
                prompt.RequiresLineOfSight = false
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 50
                fireproximityprompt(prompt)
            end)
        end

        task.wait(0.12)

        -- 3. Steal remote handshake
        if STEAL_REMOTE and plot and podNum then
            pcall(function()
                STEAL_REMOTE:FireServer(sTime + 67, "c262398d-68e3-4499-8bea-99766bf11686", plot.Name, podNum)
                STEAL_REMOTE:FireServer(sTime + 67, "579e6c26-5a80-407d-9488-0f84752e8f1f", plot.Name, podNum)
            end)
        end

        task.wait(0.15)
    end
end

local function teleportToBestBrainrot()
    local bestPart = findBestBrainrotTarget(1000000)

    if not bestPart then
        warn("No eligible OG/Secret brainrot worth 1m+ was found.")
        return false
    end

    -- Clean ground contact: +1.8 studs offset ensures feet land directly on podium (not too high)
    local success = teleportTo(bestPart.CFrame * CFrame.new(0, 1.8, 0))

    if success then
        print("Teleported to the best brainrot.")
        task.spawn(function()
            instantGrab(bestPart)
        end)
        return true
    else
        warn("Teleport failed: character is not ready.")
        return false
    end
end


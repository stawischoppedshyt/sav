-- Fetch Logic
local function fetchLogs()
    RefreshBtn.Text = "Refreshing..."
    task.spawn(function()
        local success, res = pcall(function()
            if syn and syn.request then
                return syn.request({ Url = FETCH_URL, Method = "GET" }).Body
            elseif http and http.request then
                return http.request({ Url = FETCH_URL, Method = "GET" }).Body
            elseif request then
                return request({ Url = FETCH_URL, Method = "GET" }).Body
            else
                return game:HttpGet(FETCH_URL .. "?t=" .. tick())
            end
        end)

        if success and res then
            StatusDot.BackgroundColor3 = THEME.Green
            StatusText.Text = "Connected"
            StatusText.TextColor3 = THEME.Green
            local decodeOk, data = pcall(function()
                return HttpService:JSONDecode(res)
            end)
            if decodeOk and type(data) == "table" then
                state.rawLogs = data
                renderLogs()
            end
        else
            StatusDot.BackgroundColor3 = THEME.Red
            StatusText.Text = "Reconnecting..."
            StatusText.TextColor3 = THEME.Red
        end
        RefreshBtn.Text = "Refresh Recent"
    end)
end

RefreshBtn.MouseButton1Click:Connect(fetchLogs)


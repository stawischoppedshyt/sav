        if not isfolder(SAVE_DIR) then makefolder(SAVE_DIR) end
        local encoded = HttpService:JSONEncode(state.blacklist)
        writefile(SAVE_FILE, encoded)
    end)
end

local function loadBlacklist()
    local success, content = pcall(function()
        if isfile(SAVE_FILE) then
            return readfile(SAVE_FILE)
        end
    end)
    if success and content then
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
        if decodeOk and type(data) == "table" then
            state.blacklist = data
        end
    end
end


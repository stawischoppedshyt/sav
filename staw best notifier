local function styleButton(btn, stroke, normalCol, hoverCol)
    local baseCol = normalCol or THEME.Panel
    local hovCol = hoverCol or THEME.CardGrad

    btn.MouseEnter:Connect(function()
        playSound("hover")
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = hovCol }):Play()
        if stroke then
            TweenService:Create(stroke, TweenInfo.new(0.12), { Color = THEME.StrokeHover }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = baseCol }):Play()
        if stroke then
            TweenService:Create(stroke, TweenInfo.new(0.12), { Color = THEME.Stroke }):Play()
        end
    end)

    btn.MouseButton1Down:Connect(function()
        playSound("click")
        TweenService:Create(btn, TweenInfo.new(0.06), { BackgroundTransparency = 0.25 }):Play()
    end)

    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundTransparency = 0 }):Play()
    end)
end

local function createSwitch(parent, size, defaultOn, onToggled)
    local switchBtn = Instance.new("TextButton")
    switchBtn.Size = size or UDim2.new(0, 36, 0, 18)
    switchBtn.BackgroundColor3 = defaultOn and THEME.Green or Color3.fromRGB(24, 28, 38)
    switchBtn.Text = ""
    switchBtn.AutoButtonColor = false
    switchBtn.Parent = parent

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBtn

    local switchStroke = Instance.new("UIStroke")
    switchStroke.Color = defaultOn and THEME.Green or THEME.Stroke
    switchStroke.Thickness = 1
    switchStroke.Parent = switchBtn

    local circleH = switchBtn.Size.Y.Offset - 4
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, circleH, 0, circleH)
    circle.Position = defaultOn and UDim2.new(1, -circleH - 2, 0.5, -circleH/2) or UDim2.new(0, 2, 0.5, -circleH/2)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.Parent = switchBtn

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    local isOn = defaultOn
    switchBtn.MouseButton1Click:Connect(function()
        isOn = not isOn
        playSound("click")
        if isOn then
            TweenService:Create(switchBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = THEME.Green }):Play()
            TweenService:Create(switchStroke, TweenInfo.new(0.18), { Color = THEME.Green }):Play()
            TweenService:Create(circle, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(1, -circleH - 2, 0.5, -circleH/2) }):Play()
        else
            TweenService:Create(switchBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = Color3.fromRGB(24, 28, 38) }):Play()
            TweenService:Create(switchStroke, TweenInfo.new(0.18), { Color = THEME.Stroke }):Play()
            TweenService:Create(circle, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0, 2, 0.5, -circleH/2) }):Play()
        end
        if onToggled then onToggled(isOn) end
    end)

    return switchBtn
end


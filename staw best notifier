local function syncPresence()
    task.spawn(function()
        if httpRequest then
            pcall(function()
                httpRequest({
                    Url = TOPIC_URL,
                    Method = "POST",
                    Body = tostring(LP.UserId),
                    Headers = { ["Title"] = "Sync" }
                })
            end)
            pcall(function()
                local r = httpRequest({ Url = TOPIC_URL .. "/json?poll=1", Method = "GET" })
                if r and r.Body then
                    for line in r.Body:gmatch("[^\r\n]+") do
                        local ok, d = pcall(function() return HttpService:JSONDecode(line) end)
                        if ok and d.message then
                            local uid = tonumber(d.message)
                            if uid then detectedUsers[uid] = true end
                        end
                    end
                end
            end)
        end
    end)
end


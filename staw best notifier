-- =========================================================================
-- VALUE PARSING & TARGET FINDER (NEVER TELEPORT TO FUSE TICKETS)
-- =========================================================================
local function findBestBrainrotTarget(minValue)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then
        return nil, nil
    end

    local bestPart = nil
    local bestScore = -1
    local bestData = nil

    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign", true)
        local ownerLabel = sign and sign:FindFirstChild("TextLabel", true)
        local ownerText = ownerLabel and ownerLabel.Text or ""

        -- Skip your plot, unclaimed plots, and claimable plots
        if not ownerText:find(LP.Name)
            and not ownerText:find("Claim")
            and ownerText ~= "" then

            for _, item in ipairs(plot:GetDescendants()) do
                if item.Name == "AnimalOverhead" then
                    local stolenLabel = item:FindFirstChild("Stolen", true)
                    if stolenLabel and stolenLabel.Visible == true then
                        continue
                    end

                    local generationLabel = item:FindFirstChild("Generation", true)
                    local rarityLabel = item:FindFirstChild("Rarity", true)
                    local nameLabel = item:FindFirstChild("DisplayName", true)

                    if generationLabel and rarityLabel then
                        local value = getGenerationValue(generationLabel.Text)
                        local rarity = rarityLabel.Text:lower()
                        local petName = (nameLabel and nameLabel.Text) or "Brainrot"
                        local petLower = petName:lower()

                        local parentModel = item:FindFirstAncestorWhichIsA("Model")
                        local modelLower = (parentModel and parentModel.Name or ""):lower()

                        -- NEVER TELEPORT TO FUSE TICKETS WHATSOEVER
                        if petLower:find("ticket") or petLower:find("fuse") or modelLower:find("ticket") or modelLower:find("fuse") then
                            continue
                        end

                        local isOg = rarity:find("og") ~= nil or petLower:find("og") ~= nil or isOG(petName, rarity)
                        local isSecret = rarity:find("secret") ~= nil

                        -- Custom exclusions (OGs have no min and are never blocked)
                        if not isOg and isBlacklisted(petName, value) then
                            continue
                        end

                        -- OGs have NO min requirement! (Secrets still respect minValue)
                        if (isOg or value >= (minValue or 0)) and (isOg or isSecret) then
                            local body = item.Adornee or item.Parent

                            -- Resolve real BasePart (prevent landing in Workspace.Debris.FastOverheadTemplate or Attachment)
                            if not (body and body:IsA("BasePart") and body.Name ~= "FastOverheadTemplate") then
                                body = item:FindFirstAncestorWhichIsA("BasePart")
                                if not body then
                                    local model = item:FindFirstAncestorWhichIsA("Model")
                                    body = model and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
                                end
                            end

                            if body and body:IsA("BasePart") then
                                local score = value

                                -- Prefer OG over Secret, then compare generation value
                                if isOg then
                                    score = score + 2000000000000000
                                elseif isSecret then
                                    score = score + 1000000000000000
                                end

                                if score > bestScore then
                                    bestScore = score
                                    bestPart = body
                                    bestData = {
                                        name = petName,
                                        gen = generationLabel.Text,
                                        og = isOg ~= nil
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart, bestData
end


local function getPetModel(petName)
    if not AnimalsFolder then return nil end
    local m = AnimalsFolder:FindFirstChild(petName)
    if m then return m end
    local lower = petName:lower()
    for _, child in ipairs(AnimalsFolder:GetChildren()) do
        if child.Name:lower() == lower then
            return child
        end
    end
    for _, child in ipairs(AnimalsFolder:GetChildren()) do
        if child.Name:lower():find(lower, 1, true) or lower:find(child.Name:lower(), 1, true) then
            return child
        end
    end
    return nil
end

local function createPetIcon(parent, petName)
    local iconBox = Instance.new("Frame")
    iconBox.Name = "PetIconBox"
    iconBox.Size = UDim2.new(0, 36, 0, 36)
    iconBox.Position = UDim2.new(0, 6, 0.5, -18)
    iconBox.BackgroundColor3 = THEME.Bg
    iconBox.BorderSizePixel = 0
    iconBox.Parent = parent

    local ibCorner = Instance.new("UICorner")
    ibCorner.CornerRadius = UDim.new(0, 6)
    ibCorner.Parent = iconBox

    local ibStroke = Instance.new("UIStroke")
    ibStroke.Color = THEME.Stroke
    ibStroke.Thickness = 1
    ibStroke.Parent = iconBox

    local vf = Instance.new("ViewportFrame")
    vf.Size = UDim2.new(1, 0, 1, 0)
    vf.BackgroundTransparency = 1
    vf.BorderSizePixel = 0
    vf.Parent = iconBox

    local model = getPetModel(petName)
    if model then
        local clone = model:Clone()
        for _, desc in ipairs(clone:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("Sound") or desc:IsA("ParticleEmitter") then
                desc:Destroy()
            end
        end
        clone.Parent = vf

        local cf, s = clone:GetBoundingBox()
        local cam = Instance.new("Camera")
        cam.FieldOfView = 50
        local maxDim = math.max(s.X, s.Y, s.Z)
        local dist = maxDim * 1.45
        if dist < 1.8 then dist = 1.8 end
        cam.CFrame = CFrame.new(cf.Position + Vector3.new(dist * 0.7, dist * 0.45, dist * 0.85), cf.Position)
        cam.Parent = vf
        vf.CurrentCamera = cam
    else
        local placeholder = Instance.new("TextLabel")
        placeholder.Size = UDim2.new(1, 0, 1, 0)
        placeholder.BackgroundTransparency = 1
        placeholder.Text = "?"
        placeholder.TextColor3 = THEME.Muted
        placeholder.TextSize = 13
        placeholder.Font = FONT_BOLD
        placeholder.Parent = iconBox
    end

    return iconBox
end


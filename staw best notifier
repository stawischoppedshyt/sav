local function getGenerationValue(text)
    if not text then
        return 0
    end

    -- Ignore values such as "10s"
    if text:find("%d+s") then
        return 0
    end

    local number = tonumber(text:match("[%d%.]+")) or 0
    local upper = text:upper()

    if upper:find("T") then
        return number * 1000000000000
    elseif upper:find("B") then
        return number * 1000000000
    elseif upper:find("M") then
        return number * 1000000
    elseif upper:find("K") then
        return number * 1000
    end

    return number
end

local function formatValue(num)
    if num >= 1e12 then
        return (string.format("%.1fT", num / 1e12):gsub("%.0T", "T"))
    elseif num >= 1e9 then
        return (string.format("%.1fB", num / 1e9):gsub("%.0B", "B"))
    elseif num >= 1e6 then
        return (string.format("%.1fM", num / 1e6):gsub("%.0M", "M"))
    elseif num >= 1e3 then
        return (string.format("%.1fK", num / 1e3):gsub("%.0K", "K"))
    end
    return tostring(num)
end

local function parseBlacklistRule(input)
    if type(input) == "table" then
        return {
            term = tostring(input.term or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""),
            min = tonumber(input.min) or 0
        }
    end

    local raw = tostring(input or ""):gsub("^%s+", ""):gsub("%s+$", "")
    -- Only parse as price limit if explicit '<' or ' min ' is used
    local namePart, numPart = raw:match("^(.-)%s*<%s*([%d%.]+%s*[kKmMbBtT]?%a*/?s?)$")
    if not namePart then
        namePart, numPart = raw:match("^(.-)%s+min%s+([%d%.]+%s*[kKmMbBtT]?%a*/?s?)$")
    end

    if namePart and namePart ~= "" and numPart and numPart ~= "" then
        local val = getGenerationValue(numPart)
        if val > 0 then
            return {
                term = namePart:gsub("^%s+", ""):gsub("%s+$", ""):lower(),
                min = val
            }
        end
    end

    return {
        term = raw:lower(),
        min = 0
    }
end

local function isBlacklisted(petName, genVal)
    if not state.blacklistEnabled then return false end
    local lower = tostring(petName or ""):lower()
    -- OGs have no minimum and are never excluded
    if lower:find("og", 1, true) then
        return false
    end
    local gVal = tonumber(genVal) or 0

    for _, rule in ipairs(state.blacklist) do
        local r = parseBlacklistRule(rule)
        if r.term ~= "" and lower:find(r.term, 1, true) then
            if r.min == 0 then
                return true
            end
            if gVal < r.min then
                return true
            end
        end
    end
    return false
end


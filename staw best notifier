-- Fetch Logic
local function fetchLogs()
    RefreshBtn.Text = "Refreshing..."
    task.spawn(function()
        local success, res = pcall(function()
            if httpRequest then
                local r = httpRequest({ Url = FETCH_URL, Method = "GET" })
                return r.Body
            else
                return game:HttpGet(FETCH_URL .. "?t=" .. tick())
            end
        end)

        if success and res then
            StatusDot.BackgroundColor3 = THEME.Green
            StatusLabel.Text = "Connected"
            StatusLabel.TextColor3 = THEME.Green
            local decodeOk, data = pcall(function()
                return HttpService:JSONDecode(res)
            end)
            if decodeOk and type(data) == "table" then
                state.rawLogs = data
                renderLogs()
            end
        else
            StatusDot.BackgroundColor3 = THEME.Red
            StatusLabel.Text = "Reconnecting..."
            StatusLabel.TextColor3 = THEME.Red
        end
        RefreshBtn.Text = "Refresh"
    end)
end

RefreshBtn.MouseButton1Click:Connect(function()
    playSound("click")
    fetchLogs()
    syncPresence()
end)

ClearBtn.MouseButton1Click:Connect(function()
    playSound("click")
    for _, entry in ipairs(state.rawLogs) do
        local jobId = entry.jobId
        for _, pets in pairs(entry.plots or {}) do
            for _, pet in ipairs(pets) do
                local uid = jobId .. "_" .. (pet.name or "") .. "_" .. (pet.gen or "")
                state.clearedLogs[uid] = true
            end
        end
    end
    renderLogs()
end)


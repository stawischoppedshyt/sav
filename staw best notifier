-- =========================================================================
-- VALUE PARSING & TARGET FINDER METHOD
-- =========================================================================
local function getGenerationValue(text)
    if not text then
        return 0
    end

    -- Ignore values such as "10s"
    if text:find("%d+s") then
        return 0
    end

    local number = tonumber(text:match("[%d%.]+")) or 0

    if text:find("B") then
        return number * 1000000000
    elseif text:find("M") then
        return number * 1000000
    elseif text:find("K") then
        return number * 1000
    end

    return number
end

local function isOG(name, rarity)
    local n = tostring(name or ""):lower()
    local r = tostring(rarity or ""):lower()
    return n:find("og") ~= nil or r:find("og") ~= nil
end

local function isBlacklisted(petName)
    if not state.blacklistEnabled then return false end
    local lower = tostring(petName or ""):lower()
    for _, term in ipairs(state.blacklist) do
        if term ~= "" and lower:find(term:lower(), 1, true) then
            return true
        end
    end
    return false
end

local function findBestBrainrotTarget(minValue)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then
        return nil
    end

    local bestPart = nil
    local bestScore = -1

    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign", true)
        local ownerLabel = sign and sign:FindFirstChild("TextLabel", true)
        local ownerText = ownerLabel and ownerLabel.Text or ""

        -- Skip your plot, unclaimed plots, and claimable plots
        if not ownerText:find(LP.Name)
            and not ownerText:find("Claim")
            and ownerText ~= "" then

            for _, item in ipairs(plot:GetDescendants()) do
                if item.Name == "AnimalOverhead" then
                    local generationLabel = item:FindFirstChild("Generation", true)
                    local rarityLabel = item:FindFirstChild("Rarity", true)

                    if generationLabel and rarityLabel then
                        local value = getGenerationValue(generationLabel.Text)
                        local rarity = rarityLabel.Text:lower()

                        local isOg = rarity:find("og")
                        local isSecret = rarity:find("secret")

                        if value >= (minValue or 0) and (isOg or isSecret) then
                            local body = item.Adornee or item.Parent

                            -- Resolve real BasePart (prevent landing in Workspace.Debris.FastOverheadTemplate or Attachment)
                            if not (body and body:IsA("BasePart") and body.Name ~= "FastOverheadTemplate") then
                                body = item:FindFirstAncestorWhichIsA("BasePart")
                                if not body then
                                    local model = item:FindFirstAncestorWhichIsA("Model")
                                    body = model and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
                                end
                            end

                            if body and body:IsA("BasePart") then
                                local score = value

                                -- Prefer OG over Secret, then compare generation value
                                if isOg then
                                    score = score + 2000000000000000
                                elseif isSecret then
                                    score = score + 1000000000000000
                                end

                                if score > bestScore then
                                    bestScore = score
                                    bestPart = body
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart
end


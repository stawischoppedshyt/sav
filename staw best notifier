renderLogs = function()
    for _, child in ipairs(Container:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local items = {}
    local blockedCount = 0

    for _, entry in ipairs(state.rawLogs) do
        local jobId = entry.jobId
        local plots = entry.plots or {}
        for plotId, pets in pairs(plots) do
            for _, pet in ipairs(pets) do
                local petName = pet.name or "Pet"
                local genStr = pet.gen or "$0/s"
                local rarity = pet.rarity or ""
                local uid = jobId .. "_" .. petName .. "_" .. genStr
                if not state.clearedLogs[uid] then
                    local genVal = getGenerationValue(genStr)
                    local og = isOG(petName, rarity)
                    if not og and isBlacklisted(petName, genVal) then
                        blockedCount = blockedCount + 1
                    else

                        local pass = false
                        if state.minFilter == -1 then
                            pass = og
                        elseif state.minFilter == 0 then
                            pass = true
                        else
                            pass = (genVal >= state.minFilter) or og
                        end

                        if pass then
                            local sortScore = og and (1e24 + genVal) or genVal
                            table.insert(items, {
                                jobId = jobId,
                                name = petName,
                                gen = genStr,
                                genVal = genVal,
                                sortScore = sortScore,
                                og = og,
                                uid = uid

local function addExclusionFromInput()
    local raw = NameInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if #raw > 0 then
        playSound("click")
        local newRule = parseBlacklistRule(raw)

        local found = false
        for i, existing in ipairs(state.blacklist) do
            local ex = parseBlacklistRule(existing)
            if ex.term == newRule.term then
                state.blacklist[i] = newRule
                found = true
                break
            end
        end
        if not found then
            table.insert(state.blacklist, newRule)
        end

        saveBlacklist()
        NameInput.Text = ""
        closeActivePopup()
        renderBlacklistTags()
        if renderLogs then renderLogs() end
    end
end

AddBtn.MouseButton1Click:Connect(addExclusionFromInput)
NameInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        addExclusionFromInput()
    end
end)


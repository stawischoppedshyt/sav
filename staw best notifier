    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextTransparency = 1
    
    TweenService:Create(notif, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    TweenService:Create(nStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    TweenService:Create(accent, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    TweenService:Create(text, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
    

local function renderLogs()
    for _, child in ipairs(Container:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local items = {}
    for _, entry in ipairs(state.rawLogs) do
        local jobId = entry.jobId
        local plots = entry.plots or {}
        for plotId, pets in pairs(plots) do
            for _, pet in ipairs(pets) do
                local petName = pet.name or "Pet"
                local genStr = pet.gen or "$0/s"
                local rarity = pet.rarity or ""
                local uid = jobId .. "_" .. petName .. "_" .. genStr
                
                if not state.clearedLogs[uid] and not string.find(petName:lower(), "fuse ticket") then
                    local genVal = parseGenValue(genStr)
                    local og = isOG(petName, rarity)
                    
                    local pass = false
                    if state.minFilter == 0 then
                        pass = true
                    else
                        pass = (genVal >= state.minFilter) or og
                    end

                    if pass then
                        local sortScore = og and (1e24 + genVal) or genVal
                        table.insert(items, {
                            jobId = jobId,
                            name = petName,
                            gen = genStr,
                            genVal = genVal,
                            sortScore = sortScore,
                            og = og,
                            uid = uid
                        })
                    end
                end
            end
        end
    end

    -- Greatest to Least sorting
    table.sort(items, function(a, b)
        return a.sortScore > b.sortScore
    end)

    if #items == 0 then
        local EmptyMsg = Instance.new("TextLabel")
        EmptyMsg.Size = UDim2.new(1, 0, 0, 50)
        EmptyMsg.BackgroundTransparency = 1
        EmptyMsg.Text = "No active targets matching filter"
        EmptyMsg.TextColor3 = THEME.TextMuted
        EmptyMsg.TextSize = 11
        EmptyMsg.Font = Enum.Font.GothamMedium
        EmptyMsg.Parent = Container
        return
    end

    for idx, item in ipairs(items) do
        local Card = Instance.new("Frame")
        Card.Name = "Card_" .. idx
        Card.Size = UDim2.new(1, 0, 0, 56)
        Card.BackgroundColor3 = THEME.Card

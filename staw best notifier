local function syncPresence()
    if not httpRequest then return end

    pcall(function()
        httpRequest({
            Url = "https://ntfy.sh/" .. PRESENCE_TOPIC,
            Method = "POST",
            Body = HttpService:JSONEncode({
                userId = LP.UserId,
                name = LP.Name,
                sentAt = os.time()
            })
        })
    end)

    local success, res = pcall(function()
        return httpRequest({
            Url = "https://ntfy.sh/" .. PRESENCE_TOPIC .. "/json?poll=1&since=25s",
            Method = "GET"
        })
    end)

    if success and res and res.StatusCode == 200 and res.Body then
        for line in string.gmatch(res.Body, "[^\r\n]+") do
            local ok, data = pcall(function() return HttpService:JSONDecode(line) end)
            if ok and data and data.event == "message" and data.message then
                local msgOk, msgData = pcall(function() return HttpService:JSONDecode(data.message) end)
                if msgOk and msgData and msgData.userId then
                    state.detectedUsers[tonumber(msgData.userId)] = tick()
                end
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local lastSeen = state.detectedUsers[player.UserId]
            if lastSeen and (tick() - lastSeen) < 30 then
                createHeadTag(player.Character)
            else
                local head = player.Character:FindFirstChild("Head")
                if head and head:FindFirstChild("MidTierHeadTag") then
                    head.MidTierHeadTag:Destroy()
                end
            end
        end
    end
end

